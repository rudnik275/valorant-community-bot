# .env.vps.1password — VPS-only secrets from vaults OUTSIDE valorant-community-bot.
#
# scripts/deploy-env.sh resolves this file together with .env.1password into
# the VPS .env. Nothing local reads it: `with-secrets` resolves .env.1password
# through this repo's read-only Service Account, which sees only the
# valorant-community-bot vault, and `op run` fails on any reference it cannot
# read (#359). Keep only references the app never needs on a dev machine.

# ─── Litestream → Hetzner Object Storage ────────────────────────────────────
# Bucket + endpoint (non-secret) stay in .env.1password. The key lives in the
# shared SlotRanker vault as `hetzner-s3-backups` — NOT `hetzner-s3`, which was
# reused 2026-08-03 for a different bucket (see the note in .env.1password).
LITESTREAM_S3_ACCESS_KEY_ID=op://SlotRanker/hetzner-s3-backups/access_key
LITESTREAM_S3_SECRET_ACCESS_KEY=op://SlotRanker/hetzner-s3-backups/secret_key
